#include <windows.h>
1 RT_MANIFEST "app.manifest"
101 ICON "app.ico"
201 RCDATA "THIRD-PARTY-NOTICES.txt"
202 RCDATA "../tests/demo_main.json"
203 RCDATA "../tests/demo_rizia.json"
204 BITMAP "sponsor/wechat.bmp"
206 BITMAP "sponsor/paypal.bmp"
207 BITMAP "sponsor/usdt-trc20.bmp"
1 VERSIONINFO
FILEVERSION 0,23,6,0
PRODUCTVERSION 0,23,6,0
FILEFLAGSMASK 0x3fL
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Suzerain Save Studio contributors"
      VALUE "FileDescription", "Suzerain Save Studio - Sordland and Rizia Save Editor"
      VALUE "FileVersion", "0.23.6"
