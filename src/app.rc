      VALUE "OriginalFilename", "SuzerainSaveStudio.exe"
      VALUE "ProductName", "Suzerain Save Studio"
      VALUE "ProductVersion", "0.23.6"
      VALUE "Comments", "Independent fan tool. Not affiliated with Torpor Games."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
