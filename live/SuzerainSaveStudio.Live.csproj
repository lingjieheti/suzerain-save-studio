<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SuzerainSaveStudio.Live</AssemblyName>
    <Version>0.16.1</Version>
    <RootNamespace>SuzerainSaveStudio.Live</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../build/live/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <!-- These assemblies belong to the player's local game and mod loader. -->
    <LocalReference Include="$(GameRoot)/BepInEx/core/BepInEx.Core.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/core/Il2CppInterop.Runtime.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/Il2Cppmscorlib.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/Assembly-CSharp.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/Assembly-CSharp-firstpass.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/UnityEngine.CoreModule.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/UnityEngine.IMGUIModule.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/UnityEngine.UIModule.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/UnityEngine.UI.dll" />
    <LocalReference Include="$(GameRoot)/BepInEx/interop/UnityEngine.TextRenderingModule.dll" />
    <Reference Include="@(LocalReference)" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="Set GameRoot to the Suzerain installation containing BepInEx 6 IL2CPP." />
    <Error Condition="!Exists('%(LocalReference.Identity)')" Text="Missing local build reference: %(LocalReference.Identity)" />
  </Target>
</Project>
